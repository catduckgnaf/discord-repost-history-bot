# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: server (guild) ID for fast slash command sync during development.
# If set, commands are synced to this server only (instantly).
# If empty, commands are synced globally (can take up to an hour).
DEV_GUILD_ID=

# Optional: set to true to enable the bulk history commands
# (/repost-history, /repost-status, /repost-stop). Off by default, so the bot
# only forwards messages posted after a link is created.
ENABLE_HISTORY_REPOST=false
